<Window x:Class="Legend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Legend"
        Title="Legend" Width="960" Height="580"
        Icon="pack://application:,,,/Assets/Legend.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0B0B0B"/>
        <SolidColorBrush x:Key="Panel" Color="#101010"/>
        <SolidColorBrush x:Key="Panel2" Color="#141414"/>
        <SolidColorBrush x:Key="Line" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Text" Color="#E6E6E6"/>
        <SolidColorBrush x:Key="Soft" Color="#BDBDBD"/>
        <SolidColorBrush x:Key="Muted" Color="#6E6E6E"/>
        <SolidColorBrush x:Key="Accent" Color="#F0F1F3"/>
        <SolidColorBrush x:Key="Positive" Color="#E4E6EA"/>
        <SolidColorBrush x:Key="BlueAccent" Color="#A9ACB2"/>

        <FontFamily x:Key="Inter">pack://application:,,,/Fonts/#Inter</FontFamily>
        <FontFamily x:Key="InterMedium">pack://application:,,,/Fonts/#Inter</FontFamily>

        <Geometry x:Key="I.External">M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6 M15 3h6v6 M10 14L21 3</Geometry>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Inter}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Med" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource InterMedium}"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style x:Key="Bold" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="Hover" CornerRadius="6" Background="White" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsEnabled" Value="True"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.05" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.07"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.07"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Padding" Value="14,0,8,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowBtn" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="6" Background="White" Opacity="0" Margin="-12,0"/>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.03"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource Inter}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border CornerRadius="6" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1"/>
                            <Border x:Name="Ring" CornerRadius="6" BorderBrush="{StaticResource Accent}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
                            <local:Icon Data="{StaticResource I.Search}" Width="13" Height="13" Margin="10,0,0,0" HorizontalAlignment="Left"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="31,0,10,0" VerticalAlignment="Center" Focusable="False"/>
                            <TextBlock IsHitTestVisible="False" Text="Search thousands of scripts on ScriptBlox..."
                                       FontFamily="{StaticResource Inter}" FontWeight="Medium" FontSize="12"
                                       Foreground="{StaticResource Muted}"
                                       Margin="33,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#C9CDD3"/>
            <Setter Property="SelectionOpacity" Value="0.3"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="AcceptsTab" Value="True"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="SpellCheck.IsEnabled" Value="False"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="Padding" Value="6,0,12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkScrollBarRepeatButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="{StaticResource Bg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{StaticResource Bg}">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource DarkScrollBarRepeatButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="30">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBody" Background="#343434" CornerRadius="4" Margin="2,3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#505050"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Background" Value="#686868"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource DarkScrollBarRepeatButton}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="20">
                            <Border Height="4" CornerRadius="2" Background="{StaticResource Line}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{StaticResource BlueAccent}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource BlueAccent}" Stroke="{StaticResource Bg}" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"/>
                <TextBlock Text="Legend" Style="{StaticResource Bold}" FontSize="14" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Grid Width="48">
                        <Button x:Name="BtnNavHome" Style="{StaticResource IconBtn}" Width="40" Height="30" Click="BtnNavHome_Click">
                            <local:Icon x:Name="NavHome" Data="{StaticResource I.Home}" Width="17" Height="17"/>
                        </Button>
                        <Border Height="2" Width="22" Background="{StaticResource Accent}" VerticalAlignment="Bottom" CornerRadius="1" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="HomeLineScale" ScaleX="1"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <Grid Width="48">
                        <Button x:Name="BtnNavCode" Style="{StaticResource IconBtn}" Width="40" Height="30" Click="BtnNavCode_Click">
                            <local:Icon x:Name="NavCode" Data="{StaticResource I.Code}" Width="17" Height="17"/>
                        </Button>
                        <Border Height="2" Width="22" Background="{StaticResource Accent}" VerticalAlignment="Bottom" CornerRadius="1" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CodeLineScale" ScaleX="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <Grid Width="48">
                        <Button x:Name="BtnNavHub" Style="{StaticResource IconBtn}" Width="40" Height="30" Click="BtnNavHub_Click" Opacity="1">
                            <local:Icon x:Name="NavHub" Data="{StaticResource I.Bag}" Width="17" Height="17"/>
                        </Button>
                        <Border Height="2" Width="22" Background="{StaticResource Accent}" VerticalAlignment="Bottom" CornerRadius="1" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="HubLineScale" ScaleX="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <Grid Width="48">
                        <Button x:Name="BtnNavSettings" Style="{StaticResource IconBtn}" Width="40" Height="30" Click="BtnNavSettings_Click">
                            <local:Icon x:Name="NavSettings" Data="{StaticResource I.Settings}" Width="17" Height="17"/>
                        </Button>
                        <Border Height="2" Width="22" Background="{StaticResource Accent}" VerticalAlignment="Bottom" CornerRadius="1" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="SettingsLineScale" ScaleX="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource Muted}" Margin="0,0,6,0">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock x:Name="StatusText" Text="Idle" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource IconBtn}" Width="28" Height="26" Click="BtnMin_Click">
                        <local:Icon Data="{StaticResource I.Min}" Width="12" Height="12" Thickness="2"/>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Width="28" Height="26" Click="BtnMax_Click">
                        <local:Icon Data="{StaticResource I.Max}" Width="12" Height="12" Thickness="2"/>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Foreground="#E5333A" Width="28" Height="26" Click="BtnClose_Click">
                        <local:Icon Data="{StaticResource I.X}" Width="12" Height="12" Thickness="2"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="HomePage" Grid.Row="1" Margin="28,22,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Legend" Style="{StaticResource Bold}" FontSize="17"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="Lua executor for Roblox" Style="{StaticResource Med}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource Accent}" Background="#161616">
                                    <TextBlock Text="ONTOP" Style="{StaticResource Bold}" Foreground="{StaticResource Accent}" FontSize="9"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ActionBtn}" Height="38" Padding="16,0">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="16" Height="12" Margin="0,0,8,0">
                                    <Border Background="#E5333A" CornerRadius="3.5"/>
                                    <Path Data="M6.4 3.6 L11 6 L6.4 8.4 Z" Fill="White"/>
                                </Grid>
                                <TextBlock Text="YouTube" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionBtn}" Height="38" Padding="16,0" Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <Canvas Width="16" Height="12" Margin="0,0,8,0">
                                    <Path Fill="#5865F2" Data="M3.2 1.2 Q5.2 0.2 6.6 0 L7 0.8 Q8 0.7 9 0.8 L9.4 0 Q10.8 0.2 12.8 1.2 Q15 4.5 15.4 9.4 Q13.8 10.9 11.9 11.4 L11.2 10.2 Q9.8 10.6 8 10.6 Q6.2 10.6 4.8 10.2 L4.1 11.4 Q2.2 10.9 0.6 9.4 Q1 4.5 3.2 1.2 Z"/>
                                    <Ellipse Canvas.Left="4" Canvas.Top="4.2" Width="2.6" Height="3.2" Fill="#0B0B0B"/>
                                    <Ellipse Canvas.Left="9.4" Canvas.Top="4.2" Width="2.6" Height="3.2" Fill="#0B0B0B"/>
                                </Canvas>
                                <TextBlock Text="Discord" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="20,16,20,10">
                    <StackPanel>
                        <TextBlock Text="QUICK ACTIONS" Style="{StaticResource Med}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,10"/>
                        <Button Style="{StaticResource RowBtn}" Click="BtnNavCode_Click">
                            <Grid>
                                <TextBlock Text="Open Script Editor" Style="{StaticResource Med}" FontSize="13"/>
                                <local:Icon Data="{StaticResource I.Code}" Stroke="{StaticResource Accent}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Button>
                        <Border Height="1" Background="{StaticResource Line}"/>
                        <Button Style="{StaticResource RowBtn}" Click="BtnInject_Click">
                            <Grid>
                                <TextBlock Text="Inject" Style="{StaticResource Med}" FontSize="13"/>
                                <local:Icon Data="{StaticResource I.Zap}" Stroke="{StaticResource Accent}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Button>
                        <Border Height="1" Background="{StaticResource Line}"/>
                        <Button Style="{StaticResource RowBtn}" Click="BtnOpenScript_Click">
                            <Grid>
                                <TextBlock Text="Open Script File" Style="{StaticResource Med}" FontSize="13" Foreground="{StaticResource Accent}"/>
                                <local:Icon Data="{StaticResource I.File}" Stroke="{StaticResource Accent}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="EditorPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <Grid Margin="12,12,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Height="24">
                            <TextBlock Text="Explorer" FontSize="12" Foreground="{StaticResource Soft}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,-6,0">
                                <Button Style="{StaticResource IconBtn}" Width="24" Height="24" Click="BtnAddTab_Click">
                                    <local:Icon Data="{StaticResource I.Plus}" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBox Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource SearchBox}"/>
                        <TextBlock Grid.Row="2" Text="SCRIPTS" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,16,0,6"/>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="60"/>
                        <RowDefinition x:Name="TerminalRow" Height="150"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer x:Name="TabScroll" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="TabScroll_Wheel">
                            <StackPanel x:Name="TabPanel" Orientation="Horizontal"/>
                        </ScrollViewer>
                        <Button Grid.Column="1" Style="{StaticResource IconBtn}" Width="30" Height="30" Margin="2,0,10,0" Click="BtnAddTab_Click">
                            <local:Icon Data="{StaticResource I.Plus}" Width="15" Height="15"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Background="{StaticResource Bg}">
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"/>
                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Canvas ClipToBounds="True" IsHitTestVisible="False">
                                <TextBlock x:Name="LineNumbers" Text="1" Width="56" TextAlignment="Right" Padding="0,0,14,0" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Top"/>
                            </Canvas>
                            <TextBox x:Name="Editor" Grid.Column="1" Style="{StaticResource EditorBox}"/>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="2" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                        <Grid Margin="12,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Button Style="{StaticResource ActionBtn}" Click="BtnExecute_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource I.Play}" Stroke="{StaticResource Soft}" Width="14" Height="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Execute" Style="{StaticResource Med}" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ActionBtn}" Click="BtnClear_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource I.Trash}" Stroke="{StaticResource Soft}" Width="14" Height="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Clear" Style="{StaticResource Med}" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ActionBtn}" Click="BtnOpenScript_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource I.Folder}" Stroke="{StaticResource Soft}" Width="14" Height="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Open" Style="{StaticResource Med}" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ActionBtn}" Click="BtnSaveScript_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <local:Icon Data="{StaticResource I.Save}" Stroke="{StaticResource Soft}" Width="14" Height="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Save" Style="{StaticResource Med}" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="TerminalPanel" Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="14,0,10,0">
                                <TextBlock Text="Terminal" Style="{StaticResource Bold}" FontSize="12"/>
                                <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Right" Click="BtnClearTerminal_Click">
                                    <TextBlock Text="Clear" FontSize="10" Foreground="{StaticResource Muted}"/>
                                </Button>
                            </Grid>
                            <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                                <RichTextBox x:Name="LogsBox" IsReadOnly="True" IsDocumentEnabled="False"
                                             Background="Transparent" BorderThickness="0"
                                             FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Text}"
                                             Padding="14,8,8,8" CaretBrush="Transparent"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="ScriptHubPage" Grid.Row="1" Visibility="Collapsed" Margin="28,22,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBox x:Name="HubSearchBox" Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch" KeyDown="HubSearchBox_KeyDown"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,3,0,0">
                    <TextBlock x:Name="HubStatus" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                </Grid>

                <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="HubCardsPanel" Margin="0,0,0,20"/>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" Margin="28,22,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="Settings" Style="{StaticResource Bold}" FontSize="17"/>
                        <TextBlock Text="Legend preferences" Style="{StaticResource Med}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource ActionBtn}" Height="32" Padding="12,0" HorizontalAlignment="Right" Click="BtnResetSettings_Click">
                        <TextBlock Text="Reset settings" FontSize="11" Style="{StaticResource Med}"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,20">
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Window" Style="{StaticResource Bold}" FontSize="12" Margin="0,0,0,12"/>
                                <Border Background="{StaticResource Panel2}" CornerRadius="6" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,0">
                                    <Grid Height="40">
                                        <TextBlock Text="Always on top" FontSize="12" Foreground="{StaticResource Soft}"/>
                                        <Button x:Name="BtnAlwaysOnTop" Style="{StaticResource IconBtn}" HorizontalAlignment="Right" Click="BtnAlwaysOnTop_Click">
                                            <TextBlock x:Name="TxtAlwaysOnTop" Text="Disabled" FontSize="11" Foreground="{StaticResource Muted}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Background="{StaticResource Panel2}" CornerRadius="6" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,0" Margin="0,8,0,0">
                                    <Grid Height="40">
                                        <TextBlock Text="Auto Attach" FontSize="12" Foreground="{StaticResource Soft}"/>
                                        <Button x:Name="BtnAutoAttach" Style="{StaticResource IconBtn}" HorizontalAlignment="Right" Click="BtnAutoAttach_Click">
                                            <TextBlock x:Name="TxtAutoAttach" Text="Disabled" FontSize="11" Foreground="{StaticResource Muted}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Background="{StaticResource Panel2}" CornerRadius="6" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,0" Margin="0,8,0,0">
                                    <Grid Height="40">
                                        <TextBlock Text="Show Terminal" FontSize="12" Foreground="{StaticResource Soft}"/>
                                        <Button x:Name="BtnShowTerminal" Style="{StaticResource IconBtn}" HorizontalAlignment="Right" Click="BtnShowTerminal_Click">
                                            <TextBlock x:Name="TxtShowTerminal" Text="Enabled" FontSize="11" Foreground="{StaticResource Positive}" Style="{StaticResource Bold}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Editor" Style="{StaticResource Bold}" FontSize="12" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Font size" FontSize="12" Foreground="{StaticResource Soft}"/>
                                    <TextBlock x:Name="TxtFontSize" Text="11px" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderFontSize" Style="{StaticResource CustomSlider}" Minimum="10" Maximum="24" Value="11" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderFontSize_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Performance" Style="{StaticResource Bold}" FontSize="12" Margin="0,0,0,12"/>
                                <Border Background="{StaticResource Panel2}" CornerRadius="6" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,0" Margin="0,0,0,8">
                                    <Grid Height="40">
                                        <TextBlock Text="CPU Limiter" FontSize="12" Foreground="{StaticResource Soft}"/>
                                        <Button x:Name="BtnCpuLimiter" Style="{StaticResource IconBtn}" HorizontalAlignment="Right" Click="BtnCpuLimiter_Click">
                                            <TextBlock x:Name="TxtCpuLimiter" Text="Disabled" FontSize="11" Foreground="{StaticResource Muted}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Grid Margin="0,0,0,8" IsEnabled="{Binding IsEnabled, ElementName=SliderCpu}">
                                    <TextBlock Text="Limit intensity" FontSize="12" Foreground="{StaticResource Soft}"/>
                                    <TextBlock x:Name="TxtCpuIntensity" Text="10%" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderCpu" Style="{StaticResource CustomSlider}" Minimum="1" Maximum="100" Value="10" IsEnabled="False" ValueChanged="SliderCpu_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Custom Utilities" Style="{StaticResource Bold}" FontSize="12" Margin="0,0,0,12"/>
                                <Border Background="{StaticResource Panel2}" CornerRadius="6" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,0">
                                    <Grid Height="40">
                                        <TextBlock Text="Hardware Acceleration" FontSize="12" Foreground="{StaticResource Soft}"/>
                                        <Button x:Name="BtnHardwareAccel" Style="{StaticResource IconBtn}" HorizontalAlignment="Right" Click="BtnHardwareAccel_Click">
                                            <TextBlock x:Name="TxtHardwareAccel" Text="Enabled" FontSize="11" Foreground="{StaticResource Positive}" Style="{StaticResource Bold}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
