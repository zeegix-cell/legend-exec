<Application x:Class="LegendSetup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="InstallerWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0B0B0B"/>
        <SolidColorBrush x:Key="Panel" Color="#121212"/>
        <SolidColorBrush x:Key="Line" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Text" Color="#E6E6E6"/>
        <SolidColorBrush x:Key="Muted" Color="#6E6E6E"/>
        <SolidColorBrush x:Key="Accent" Color="#F0F1F3"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Application.Resources>
</Application>
