<Window x:Class="LegendSetup.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Legend Setup" Width="440" Height="220"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Assets/Legend.ico">

    <Window.Resources>
        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{StaticResource Line}" CornerRadius="2"/>
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource Accent}" CornerRadius="2"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/Legend.ico" Width="30" Height="30" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Legend" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Subtitle" Text="Installing for the current user" FontSize="11" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock x:Name="Status" Text="Preparing..." FontSize="12" Foreground="{StaticResource Text}" Margin="0,0,0,10"/>
                <ProgressBar x:Name="Progress" Style="{StaticResource Bar}" Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>

            <TextBlock x:Name="Footer" Grid.Row="2" Text="Desktop and Start Menu shortcuts are created automatically."
                       FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Window>
